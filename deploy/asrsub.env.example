# Non-secret interpolation values for the simple ASRSub deployment.
# The deploy tool writes ASRSUB_IMAGE from an exact @sha256 reference.
ASRSUB_IMAGE=ghcr.io/bedasrv/asrsub@sha256:<64-lowercase-hex>
WEBHOOK_PORT=8085
NAS_MEDIA_PREFIX=/mnt/nas/share/media
PROVIDER_KEYS_FILE=/home/user/.config/asr-pipeline/secrets/provider_keys.env
