# Non-secret interpolation values for the simple ASRSub deployment.
# The config mount retains ordinary application ledgers.
# Production Discord StateFs remains read-write at /var/lib/asrsub/state; it is
# mounted in place and is not copied or migrated by this deployment.
# The deploy tool writes ASRSUB_IMAGE from an exact @sha256 reference.
ASRSUB_IMAGE=ghcr.io/bedasrv/asrsub@sha256:<64-lowercase-hex>
WEBHOOK_PORT=8085
NAS_MEDIA_PREFIX=/mnt/nas/share/media
PROVIDER_KEYS_FILE=/var/lib/asrsub/config/provider_keys.env
