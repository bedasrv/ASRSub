# ASRSub non-secret pipeline configuration.
#
# Copy to ~/.config/asr-pipeline/pipeline.env (chmod 600) and edit, or set
# the equivalent process env. Precedence (highest wins):
#   process env > config.overrides.json > pipeline.env > defaults.
#
# NEVER put API keys here. Keys live in asrsub_providers.json (untracked) or
# in the key_env vars exported from ~/.config/asr-pipeline/secrets/provider_keys.env.
# The control key is a Docker Compose secret (/run/secrets/control_api_key).

# --- Sonarr / Bazarr ---
SONARR_URL=http://sonarr.lan:8989
SONARR_API_KEY=
BAZARR_URL=http://bazarr.lan:6767
BAZARR_API_KEY=
# Optional secondary Bazarr for the id/en profile (or a second instance):
# BAZARR_URL_2=
# BAZARR_API_KEY_2=

# --- Jellyfin library refresh (optional) ---
# There is NO compiled-in default URL. Set JELLYFIN_URL explicitly to enable
# refresh; leave it empty to keep the integration off even with a key set.
JELLYFIN_URL=http://jellyfin.lan:8096
JELLYFIN_API_KEY=
# Path prefix the Jellyfin SERVER reports for the same media. This is a
# string mapping used for refresh lookup, not a local read path.
JELLYFIN_MEDIA_ROOT=/media
# Host/NAS path THIS daemon reads media at: `/data/…` paths from
# Sonarr/Radarr map here, and `/ready` checks it is mounted. Keep it in sync
# with the compose media mount (set NAS_MEDIA_PREFIX in the compose .env too).
NAS_MEDIA_PREFIX=/mnt/nas/share/media

# --- Pipeline tuning (defaults shown) ---
TARGET_LANGS=id,en
MAX_EPS_PER_RUN=8
EPISODE_CONCURRENCY=4
ASR_CONCURRENCY=4
TRANSLATE_CONCURRENCY=16
UPLOAD_CONCURRENCY=8
# WEBHOOK_PORT=8085

# --- Environment-only tuning ---
# These are read directly from the process environment (not the config layers),
# so they must be set here / in the environment, NOT via the dashboard settings
# form (which writes config.overrides.json). Defaults shown.
# LLM_PER_ENDPOINT_CONCURRENCY=4
# LLM_TIMEOUT_S=300
# WHISPER_CONCURRENCY=4
# WHISPER_TIMEOUT_S=600
# JIMAKU_BASE_URL=https://jimaku.cc/api
# JIMAKU_CALL_SLEEP_MS=150
# JIMAKU_TIMEOUT=30
# ANILIST_TIMEOUT=30
