#!/usr/bin/env python3
"""Control CLI for the ASR pipeline orchestrator control API (stdlib only).

v1 subcommands hit the v1 ControlHandler directly on :8085:
    status config wake pause resume run-once config set/unset
v2 subcommands point at /api2/* endpoints served by the dashboard FastAPI
app (control_api_v2.py handlers, default http://127.0.0.1:8080):
    status2 activity wanted episode-retry <id> episode-skip <id>
    host override: PIPE_API2_HOST.
"""
import json
import os
import re
import sys
import urllib.error
import urllib.request

DEFAULT_HOST = "http://127.0.0.1:8085"
DEFAULT_API2_HOST = "http://127.0.0.1:8080"
ENV_FILE = "/home/user/.config/asr-pipeline/pipeline.env"


def get_host():
    return os.environ.get("PIPE_HOST", DEFAULT_HOST)


def get_api2_host():
    return os.environ.get("PIPE_API2_HOST", DEFAULT_API2_HOST)


def read_token():
    tok = os.environ.get("PIPE_TOKEN")
    if tok:
        return tok
    try:
        with open(ENV_FILE, "r", encoding="utf-8") as fh:
            for raw in fh:
                line = raw.strip()
                if line.startswith("CONTROL_API_KEY="):
                    return line.partition("=")[2].strip()
    except OSError:
        pass
    return None


def request(method, path, token=None, body=None, host=None):
    req = urllib.request.Request((host or get_host()) + path, method=method)
    req.add_header("Content-Type", "application/json")
    if token is not None:
        req.add_header("X-API-Key", token)
    data = json.dumps(body).encode("utf-8") if body is not None else None
    try:
        with urllib.request.urlopen(req, data=data) as resp:
            raw = resp.read().decode("utf-8")
            return resp.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8")
        try:
            parsed = json.loads(raw)
        except Exception:
            parsed = {"error": raw}
        return exc.code, parsed
    except urllib.error.URLError as exc:
        return 0, {"error": str(exc.reason)}


def fail(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def main(argv):
    if not argv:
        fail("usage: pctl <status|config|wake|pause|resume|run-once|status2|activity|wanted|episode-retry ID|episode-skip ID|episode-delete ID|episode-exclude ID|episode-unexclude ID|config set K=V...|config unset K...>")
    cmd = argv[0]
    if cmd == "status":
        code, body = request("GET", "/status")
        print(json.dumps(body, indent=2))
        sys.exit(0 if code == 200 else 1)
    if cmd == "config":
        if len(argv) >= 2 and argv[1] == "set":
            token = read_token()
            if not token:
                fail("PIPE_TOKEN env or CONTROL_API_KEY in pipeline.env required for config set")
            kv = {}
            for pair in argv[2:]:
                if "=" not in pair:
                    fail(f"expected KEY=VALUE, got: {pair}")
                k, _, v = pair.partition("=")
                kv[k] = v
            code, body = request("POST", "/config", token=token, body=kv)
            print(json.dumps(body, indent=2))
            sys.exit(0 if code == 200 else 1)
        if len(argv) >= 2 and argv[1] == "unset":
            token = read_token()
            if not token:
                fail("PIPE_TOKEN env or CONTROL_API_KEY in pipeline.env required for config unset")
            if len(argv) < 3:
                fail("config unset requires at least one KEY")
            body = {k: None for k in argv[2:]}
            code, resp = request("POST", "/config", token=token, body=body)
            print(json.dumps(resp, indent=2))
            sys.exit(0 if code == 200 else 1)
        token = None
        code, body = request("GET", "/config")
        print(json.dumps(body, indent=2))
        sys.exit(0 if code == 200 else 1)
    if cmd in ("wake", "pause", "resume", "run-once"):
        # All control POSTs require the token (the server denies tokenless
        # writes, including wake).
        token = read_token()
        code, body = request("POST", "/" + cmd, token=token)
        print(json.dumps(body, indent=2))
        sys.exit(0 if code == 200 else 1)
    if cmd in ("status2", "activity", "wanted"):
        path = {
            "status2": "/api2/status",
            "activity": "/api2/activity",
            "wanted": "/api2/wanted",
        }[cmd]
        code, body = request("GET", path, host=get_api2_host())
        print(json.dumps(body, indent=2))
        sys.exit(0 if code == 200 else 1)
    if cmd in ("episode-retry", "episode-skip", "episode-delete", "episode-exclude", "episode-unexclude"):
        if len(argv) < 2:
            fail(f"usage: pctl {cmd} <sonarrEpisodeId|m:<radarrId>|e:<episodeId>>")
        ep = argv[1]
        # Plain ids (series) plus m:/e: prefixes (movie/series) pass through
        # to the server, which routes on the prefix.
        if not (ep.isdigit() or re.fullmatch(r"[mMeE]:\d+", ep)):
            fail(f"episode id must be an integer or m:<id>/e:<id>, got: {ep}")
        token = read_token()
        if not token:
            fail("PIPE_TOKEN env or CONTROL_API_KEY in pipeline.env required")
        action = cmd.split("-", 1)[1]
        code, body = request("POST", f"/api2/episode/{ep}/{action}", token=token, host=get_api2_host())
        print(json.dumps(body, indent=2))
        sys.exit(0 if code == 200 else 1)
    fail(f"unknown command: {cmd}")


if __name__ == "__main__":
    main(sys.argv[1:])
