#!/usr/bin/env python3
"""Control CLI for the unified ASRSub control API (stdlib only).

The daemon serves unversioned and `/api2/*` routes on one port (default
http://127.0.0.1:8085); there is no separate dashboard/API host. Reads are
unauthenticated, while every mutation requires the control key.
"""
import json
import os
import re
import sys
import urllib.error
import urllib.request

DEFAULT_HOST = "http://127.0.0.1:8085"


def get_host():
    return os.environ.get("PIPE_HOST", DEFAULT_HOST)


def secret_candidates():
    """Control-key file locations, in precedence order."""
    candidates = []
    for name in ("CONTROL_API_KEY_FILE",):
        path = os.environ.get(name)
        if path:
            candidates.append(path)
    candidates.append("/run/secrets/control_api_key")
    config_dir = os.environ.get("ASRSUB_CONFIG_DIR") or os.path.join(
        os.path.expanduser("~"), ".config", "asr-pipeline"
    )
    candidates.append(os.path.join(config_dir, "secrets", "control_api_key"))
    return candidates


def read_token(required=True):
    """Return the control key without reading it from `pipeline.env`.

    `pipeline.env` holds non-secret settings; `CONTROL_API_KEY` must not be
    stored there. Prefer the explicit `PIPE_TOKEN` override and the configured
    secret file.
    """
    for name in ("PIPE_TOKEN", "CONTROL_API_KEY"):
        token = os.environ.get(name, "").strip()
        if token:
            return token
    for path in secret_candidates():
        try:
            with open(path, "r", encoding="utf-8") as fh:
                token = fh.read().strip()
        except OSError:
            continue
        if token:
            return token
    if required:
        fail(
            "control key required: set PIPE_TOKEN or CONTROL_API_KEY, "
            "set CONTROL_API_KEY_FILE, or provide the Compose secret file"
        )
    return None


def request(method, path, token=None, body=None):
    req = urllib.request.Request(get_host() + path, method=method)
    if token:
        req.add_header("X-API-Key", token)
    if body is not None:
        req.add_header("Content-Type", "application/json")
    data = json.dumps(body).encode("utf-8") if body is not None else None
    try:
        with urllib.request.urlopen(req, data=data) as resp:
            raw = resp.read().decode("utf-8")
            return resp.status, json.loads(raw) if raw else {}
    except urllib.error.HTTPError as exc:
        raw = exc.read().decode("utf-8")
        try:
            parsed = json.loads(raw)
        except Exception:
            parsed = {"error": raw}
        return exc.code, parsed
    except urllib.error.URLError as exc:
        return 0, {"error": str(exc.reason)}


def fail(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def get(path):
    code, body = request("GET", path)
    print(json.dumps(body, indent=2))
    sys.exit(0 if code == 200 else 1)


def post(path, body=None):
    code, data = request("POST", path, token=read_token(), body=body)
    print(json.dumps(data, indent=2))
    sys.exit(0 if code == 200 else 1)


def validated_episode_id(value):
    # Plain ids (series) plus m:/e: prefixes (movie/series) pass through
    # to the server, which routes on the prefix.
    if not (value.isdigit() or re.fullmatch(r"[mMeE]:\d+", value)):
        fail(f"episode id must be an integer or m:<id>/e:<id>, got: {value}")
    return value


def main(argv):
    if not argv:
        fail(
            "usage: pctl <status|health|ready|config|api-status|activity|"
            "wanted|episode-retry ID|episode-skip ID|episode-delete ID|"
            "episode-exclude ID|episode-unexclude ID|"
            "wake|pause|resume|run-once|config set KEY=VALUE...>"
        )
    cmd = argv[0]
    if cmd == "status":
        get("/status")
    if cmd in ("health", "ready"):
        get(f"/{cmd}")
    if cmd == "config":
        if len(argv) >= 2 and argv[1] == "set":
            kv = {}
            for pair in argv[2:]:
                if "=" not in pair:
                    fail(f"expected KEY=VALUE, got: {pair}")
                k, _, v = pair.partition("=")
                if not k.strip():
                    fail(f"expected KEY=VALUE, got: {pair}")
                kv[k.strip()] = v
            if not kv:
                fail("config set requires at least one KEY=VALUE pair")
            post("/api2/config", kv)
        if len(argv) >= 2:
            fail(
                "unsupported config subcommand: only `config` and "
                "`config set KEY=VALUE...` are supported"
            )
        get("/config")
    if cmd in ("wake", "pause", "resume", "run-once"):
        # The server denies tokenless control writes, including wake.
        post("/" + cmd)
    if cmd in ("api-status", "activity", "wanted"):
        get(
            {
                "api-status": "/api2/status",
                "activity": "/api2/activity",
                "wanted": "/api2/wanted",
            }[cmd]
        )
    if cmd in ("episode-retry", "episode-skip", "episode-delete", "episode-exclude", "episode-unexclude"):
        if len(argv) < 2:
            fail(f"usage: pctl {cmd} <sonarrEpisodeId|m:<radarrId>|e:<episodeId>>")
        action = cmd.split("-", 1)[1]
        post(f"/api2/episode/{validated_episode_id(argv[1])}/{action}")
    fail(f"unknown command: {cmd}")


if __name__ == "__main__":
    main(sys.argv[1:])
