#!/bin/sh
set -eu

# The systemd-installed wrapper has one fixed adapter source.  It never accepts
# a caller-selected repository, interpreter, environment file, or fixture.
entrypoint=/usr/local/libexec/asrsub/production_entrypoint.py
if [ -L "$entrypoint" ] || [ ! -f "$entrypoint" ]; then
    printf '%s\n' 'ASRSub production preflight blocked: approved adapter source is absent' >&2
    exit 75
fi
if [ "${1:-}" != "--reconcile" ] || [ "$#" -ne 1 ]; then
    printf '%s\n' 'ASRSub production preflight blocked: runtime action is not allowlisted' >&2
    exit 75
fi
exec /usr/bin/python3 "$entrypoint" runtime --reconcile
